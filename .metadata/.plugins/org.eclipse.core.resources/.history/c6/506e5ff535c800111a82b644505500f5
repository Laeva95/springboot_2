<table>
    <thead>
        <tr>
            <th>제목</th>
            <th>작성일시</th>
        </tr>
    </thead>
    <tbody>
		<!--
			th:each - Controller에서 Model 객체를 통해 저장해서 전달한 questionList에서 값을 하나씩 꺼내어 반복문 실행
				questionList: Model 객체에 저장한 key 값
				question: each 태그 아래에서 사용할 리스트의 각 요소			
		-->
        <tr th:each="question : ${questionList}">
            <td th:text="${question.subject}"></td>
            <td th:text="${question.createDate}"></td>
        </tr>
    </tbody>
</table>